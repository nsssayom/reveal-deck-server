# Copy to `.env` and edit. server.mjs loads `.env` via `dotenv` at startup.
# Anything left unset falls back to the default in server.mjs.

# Listen address.
# PORT=3000
# HOST=0.0.0.0

# Where deck folders live. Absolute path or relative to the server's cwd.
# DECKS_DIR=./decks

# Optional shared master secret. If unset, ANYONE can drive a deck —
# fine for a personal server on a trusted network. If set, the landing
# page will prompt for this value when you click "Speaker" on a deck.
# DECK_SECRET=
